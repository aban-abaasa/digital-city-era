# Copy to .env.local-sync in the Supabase self-hosted project directory.
# Keep BUSINESS_SYNC_NODE_SECRET server-side. Never publish this file or put
# either server key in the frontend's runtime-config.js.
CLOUD_SUPABASE_URL=https://your-shared-project.supabase.co
CLOUD_SUPABASE_ANON_KEY=your-public-anon-key
BUSINESS_SYNC_NODE_ID=00000000-0000-0000-0000-000000000000
BUSINESS_SYNC_NODE_SECRET=replace-with-the-secret-returned-once-by-pairing
BUSINESS_SYNC_POLL_MS=15000
